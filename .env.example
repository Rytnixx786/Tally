# Where large downloads (datasets, model weights) go. Defaults to <repo>/data/downloads.
TALLY_DOWNLOAD_DIR=
HF_HOME=

# Copy to .env and fill in. Never commit .env.

# Mode: replay (default, no spend) | live
TALLY_MODE=replay
TALLY_ALLOW_SPEND=0
# client = Tally emits spans itself (fallback until the Cinch telemetry PR lands); gateway = Cinch emits
TALLY_SPAN_SOURCE=gateway

# Cinch gateway
CINCH_BASE_URL=http://localhost:8181
CINCH_API_KEY=

# Hosted model for setup C (provider chosen in ADR-009)
HOSTED_PROVIDER=openai
HOSTED_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tally
POSTGRES_USER=tally_writer
POSTGRES_PASSWORD=tally_writer_local
LEXICON_RO_PASSWORD=lexicon_ro_local

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tally-harness
OTEL_INSTRUMENTATION_GENAI_CAPTURE_CONTENT=NO_CONTENT
